---
import type { GetStaticPathsOptions, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, type Article } from '../../data/articles';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return paginate(articles, { pageSize: 9 });
}

interface Props {
  page: Page<Article>;
}

const { page } = Astro.props;

const currentPage = page.currentPage;
const totalPages = page.lastPage;

function getPageUrl(pageNum: number) {
  return pageNum === 1 ? '/blog/' : `/blog/${pageNum}/`;
}

function getPaginationRange(current: number, total: number) {
  const delta = 2;
  const range: (number | string)[] = [];
  const rangeWithDots: (number | string)[] = [];
  let l: number | undefined;

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    }
  }

  for (const i of range) {
    if (typeof i === 'number') {
      if (l) {
        if (i - l === 2) {
          rangeWithDots.push(l + 1);
        } else if (i - l !== 1) {
          rangeWithDots.push('...');
        }
      }
      rangeWithDots.push(i);
      l = i;
    }
  }

  return rangeWithDots;
}

const paginationItems = getPaginationRange(currentPage, totalPages);

const pageTitle = currentPage === 1
  ? "Blog & Panduan Material Plafon Interior — Plafon PVC Solo by Griya Alfath"
  : `Blog & Panduan Material Plafon Interior (Halaman ${currentPage}) — Plafon PVC Solo by Griya Alfath`;

const pageDesc = currentPage === 1
  ? "Kumpulan artikel edukatif, panduan memilih plafon PVC, perbandingan gypsum, inspirasi desain drop ceiling, dan tips konstruksi rangka baja ringan di Solo Raya."
  : `Halaman ${currentPage} dari kumpulan artikel edukatif seputar plafon PVC, gypsum, drop ceiling, dan tips konstruksi di Solo Raya by Griya Alfath.`;

const currentPath = getPageUrl(currentPage);

const breadcrumbItems = [
  { label: 'Blog & Panduan', href: '/blog/' }
];
if (currentPage > 1) {
  breadcrumbItems.push({ label: `Halaman ${currentPage}`, href: currentPath });
}
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  currentPath={currentPath}
>
  <!-- Page Banner -->
  <section class="page-banner">
    <video autoplay muted loop playsinline poster="/images/hero/hero-plafon-main.webp" class="banner-video-bg" aria-hidden="true">
      <source src="/videos/banner-bg.mp4" type="video/mp4" />
    </video>
    <div class="banner-overlay" aria-hidden="true"></div>

    <div class="container">
      <span class="badge-sub" style="background-color: rgba(255,255,255,0.15); color: #fed7aa; margin-bottom: 0.75rem;">Edukasi &amp; Panduan</span>
      <h1 class="page-banner-title">Artikel &amp; Panduan Material Interior</h1>
      <p class="page-banner-desc">Tips praktis seputar pemilihan plafon PVC, perbandingan teknis bahan, dan inspirasi desain ruangan untuk rumah impian Anda.</p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <Breadcrumb items={breadcrumbItems} />

  <!-- Articles Grid Section -->
  <section class="section-py bg-white">
    <div class="container">
      <!-- Section Meta Header -->
      <div class="blog-list-header">
        <p class="article-count-label">
          Menampilkan <strong>{page.start + 1}–{page.end + 1}</strong> dari <strong>{page.total}</strong> artikel panduan
        </p>
      </div>

      <!-- 9 Articles Grid -->
      <div class="blog-grid">
        {page.data.map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>

      <!-- Pagination Navigation -->
      {totalPages > 1 && (
        <nav class="pagination-wrapper" aria-label="Navigasi Halaman Blog">
          <ul class="pagination-list">
            <!-- Previous Button -->
            {page.url.prev ? (
              <li class="page-item">
                <a href={getPageUrl(currentPage - 1)} class="page-link prev-next-link" aria-label="Halaman Sebelumnya">
                  &larr; <span class="hide-mobile">Sebelumnya</span>
                </a>
              </li>
            ) : (
              <li class="page-item disabled" aria-disabled="true">
                <span class="page-link prev-next-link disabled">&larr; <span class="hide-mobile">Sebelumnya</span></span>
              </li>
            )}

            <!-- Page Number Links -->
            {paginationItems.map((item) => (
              item === '...' ? (
                <li class="page-item ellipsis">
                  <span class="page-link dots">&hellip;</span>
                </li>
              ) : (
                <li class={`page-item ${item === currentPage ? 'active' : ''}`}>
                  {item === currentPage ? (
                    <span class="page-link current-page" aria-current="page">{item}</span>
                  ) : (
                    <a href={getPageUrl(item as number)} class="page-link" aria-label={`Menuju halaman ${item}`}>
                      {item}
                    </a>
                  )}
                </li>
              )
            ))}

            <!-- Next Button -->
            {page.url.next ? (
              <li class="page-item">
                <a href={getPageUrl(currentPage + 1)} class="page-link prev-next-link" aria-label="Halaman Selanjutnya">
                  <span class="hide-mobile">Selanjutnya</span> &rarr;
                </a>
              </li>
            ) : (
              <li class="page-item disabled" aria-disabled="true">
                <span class="page-link prev-next-link disabled"><span class="hide-mobile">Selanjutnya</span> &rarr;</span>
              </li>
            )}
          </ul>
        </nav>
      )}
    </div>
  </section>

  <!-- Consultation Banner -->
  <section class="section-py bg-alt">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-banner-content">
          <span class="badge-sub" style="background-color: rgba(255,255,255,0.12); color: #fed7aa; margin-bottom: 1rem;">Konsultasi Gratis</span>
          <h3>Masih Bingung Menentukan Material yang Cocok?</h3>
          <p>Tanyakan langsung kepada konsultan teknis Griya Alfath. Kami siap membantu Anda memilih antara plafon PVC, gypsum, atau baja ringan sesuai budget dan denah ruangan.</p>
          <div class="cta-banner-buttons">
            <a href="https://wa.me/6282157249454?text=Halo%20Mas%20Otello%20Griya%20Alfath,%20saya%20sedang%20membaca%20artikel%20panduan%20di%20website%20dan%20ingin%20berkonsultasi%20mengenai%20pemilihan%20material%20plafon%20yang%20tepat%20untuk%20hunian%20saya.%20Terima%20kasih!" class="btn btn-accent" target="_blank" rel="noopener">
              <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.33C9.33 7.33 9 7.41 8.74 7.69C8.47 7.96 7.74 8.64 7.74 10.05C7.74 11.45 8.77 12.81 8.91 13C9.05 13.2 10.92 16.08 13.8 17.32C14.49 17.61 15.02 17.79 15.44 17.93C16.13 18.15 16.76 18.12 17.26 18.04C17.81 17.96 18.96 17.35 19.2 16.67C19.44 16 19.44 15.41 19.37 15.3C19.3 15.19 19.11 15.12 18.82 14.98C18.53 14.84 17.11 14.14 16.85 14.05C16.59 13.95 16.4 13.91 16.21 14.2C16.02 14.5 15.48 15.12 15.31 15.3C15.15 15.5 14.99 15.52 14.7 15.37C14.41 15.23 13.49 14.93 12.4 13.96C11.55 13.2 10.98 12.27 10.82 11.98C10.65 11.7 10.8 11.54 10.95 11.4C11.08 11.27 11.24 11.06 11.39 10.89C11.53 10.72 11.58 10.6 11.68 10.4C11.77 10.2 11.72 10.03 11.65 9.89C11.58 9.74 11 8.33 10.76 7.76C10.53 7.21 10.3 7.28 10.13 7.27L9.53 7.33Z"/></svg>
              Konsultasi WhatsApp Sekarang
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-list-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .article-count-label {
    font-size: 0.95rem;
    color: #64748b;
    margin: 0;
  }

  .article-count-label strong {
    color: #0f2b48;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Pagination Styles */
  .pagination-wrapper {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
  }

  .pagination-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .page-item {
    margin: 0;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 42px;
    padding: 0 0.85rem;
    font-size: 0.925rem;
    font-weight: 600;
    color: #334155;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .page-link:hover:not(.disabled):not(.current-page):not(.dots) {
    background: #f8fafc;
    border-color: #e65100;
    color: #e65100;
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(230, 81, 0, 0.15);
  }

  .page-item.active .current-page {
    background: #e65100;
    border-color: #e65100;
    color: #ffffff;
    cursor: default;
    box-shadow: 0 2px 8px rgba(230, 81, 0, 0.25);
  }

  .prev-next-link {
    font-weight: 700;
    color: #0f2b48;
  }

  .page-link.disabled {
    color: #94a3b8;
    background: #f1f5f9;
    border-color: #e2e8f0;
    cursor: not-allowed;
  }

  .page-link.dots {
    border: none;
    background: transparent;
    color: #94a3b8;
    cursor: default;
    min-width: 32px;
  }

  @media (max-width: 640px) {
    .hide-mobile {
      display: none;
    }

    .page-link {
      min-width: 38px;
      height: 38px;
      padding: 0 0.6rem;
      font-size: 0.875rem;
    }
  }
</style>
