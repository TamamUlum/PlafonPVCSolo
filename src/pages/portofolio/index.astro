---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, serviceCategoryFilters, buildingTypeFilters } from '../../data/projects';
import { clusteredPortfolioPages } from '../../data/portfolio-posts';

const breadcrumbItems = [
  { label: 'Portofolio Proyek', href: '/portofolio/' }
];

const totalProjectsCount = projects.length + clusteredPortfolioPages.length;
const initialBulkPosts = clusteredPortfolioPages.slice(0, 4);

const pageTitle = "Portofolio Proyek Pemasangan Plafon & Interior — Plafon PVC Solo by Griya Alfath";
const pageDesc = `Dokumentasi riil ${totalProjectsCount}+ pengerjaan proyek pemasangan plafon PVC, drop ceiling, gypsum seamless, rangka baja ringan Kencana SNI, dan wall moulding di Solo Raya (Surakarta, Sukoharjo, Klaten, Boyolali, Karanganyar, Wonogiri, Sragen).`;
const canonicalUrl = "https://plafonpvcsolo.com/portofolio/";

// Structured Data: CollectionPage + BreadcrumbList
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDesc,
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": {
        "@type": "LocalBusiness",
        "name": "Plafon PVC Solo by Griya Alfath",
        "telephone": "+6282157249454",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Jl. Raya Delanggu Utara, Jl. Mondokaki No. 330, Dusun Kendon, Karang",
          "addressLocality": "Klaten",
          "addressRegion": "Jawa Tengah",
          "addressCountry": "ID"
        }
      },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": totalProjectsCount,
        "itemListElement": [
          ...projects.map((p, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "name": p.title,
            "url": `https://plafonpvcsolo.com/portofolio/${p.id}/`
          })),
          ...initialBulkPosts.slice(0, 10).map((p, index) => ({
            "@type": "ListItem",
            "position": projects.length + index + 1,
            "name": p.title,
            "url": `https://plafonpvcsolo.com/portofolio/${p.slug}/`
          }))
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://plafonpvcsolo.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Portofolio",
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  currentPath="/portofolio/"
>
  <!-- JSON-LD Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Page Banner -->
  <section class="page-banner">
    <video
      autoplay
      muted
      loop
      playsinline
      poster="/images/hero/hero-plafon-main.webp"
      class="banner-video-bg"
      aria-hidden="true"
    >
      <source src="/videos/banner-bg.mp4" type="video/mp4" />
    </video>
    <div class="banner-overlay" aria-hidden="true"></div>

    <div class="container banner-inner">
      <span class="badge-sub banner-badge">Portofolio Pekerjaan Riil</span>
      <h1 class="page-banner-title">Dokumentasi Proyek Pemasangan</h1>
      <p class="page-banner-desc">
        Dokumentasi aktual {totalProjectsCount}+ pengerjaan tim aplikator Griya Alfath untuk plafon PVC, drop ceiling, gypsum, rangka atap baja ringan, dan wall moulding di Solo Raya.
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <Breadcrumb items={breadcrumbItems} />

  <!-- Portfolio Main Section -->
  <section class="section-py bg-white">
    <div class="container">
      
      <!-- Editorial Introduction Narrative -->
      <div class="portfolio-intro-block">
        <div class="intro-content">
          <span class="intro-badge">Standar Pengerjaan Bergaransi</span>
          <h2 class="intro-heading">Bukti Pengerjaan Proyek di Lapangan</h2>
          <p class="intro-text">
            Di bawah ini adalah sebagian dokumentasi pekerjaan tim Griya Alfath. Mulai dari hunian tinggal keluarga, gerai usaha komersial, gedung pertemuan, hingga rumah ibadah di Surakarta, Sukoharjo, Klaten, Boyolali, Karanganyar, Wonogiri, dan Sragen.
          </p>
          <p class="intro-subtext">
            Kami menjunjung tinggi transparansi material, presisi perakitan rangka berjarak rapat, dan kerapian sambungan interlocking. Klik pada masing-masing proyek untuk mempelajari teknis pemasangan, material yang digunakan, dan galeri dokumentasi lengkap.
          </p>
        </div>
        <div class="intro-stats-grid">
          <div class="stat-card">
            <span class="stat-num">{totalProjectsCount}+</span>
            <span class="stat-lbl">Dokumentasi Riil Terverifikasi</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">SNI</span>
            <span class="stat-lbl">Material Rangka Teruji</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">Gratis</span>
            <span class="stat-lbl">Konsultasi &amp; Survei Solo Raya</span>
          </div>
        </div>
      </div>

      <!-- Two-Dimensional Dropdown Filter -->
      <div class="portfolio-filter-panel" id="portfolioFilterPanel">
        <div class="filter-dropdowns-row">
          <!-- Service Category Dropdown -->
          <div class="filter-select-group">
            <label for="serviceFilterSelect" class="filter-select-label">
              <svg class="filter-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
              Filter Layanan Pemasangan:
            </label>
            <div class="custom-select-box">
              <select id="serviceFilterSelect" class="styled-select" aria-label="Filter Berdasarkan Layanan">
                {serviceCategoryFilters.map((s) => (
                  <option value={s.slug}>{s.label}</option>
                ))}
              </select>
              <svg class="select-arrow" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 10l5 5 5-5z"/></svg>
            </div>
          </div>

          <!-- Building Type Dropdown -->
          <div class="filter-select-group">
            <label for="buildingFilterSelect" class="filter-select-label">
              <svg class="filter-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z"/></svg>
              Filter Jenis Bangunan:
            </label>
            <div class="custom-select-box">
              <select id="buildingFilterSelect" class="styled-select" aria-label="Filter Berdasarkan Jenis Bangunan">
                {buildingTypeFilters.map((b) => (
                  <option value={b.slug}>{b.label}</option>
                ))}
              </select>
              <svg class="select-arrow" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 10l5 5 5-5z"/></svg>
            </div>
          </div>
        </div>

        <!-- Status Summary Bar -->
        <div class="filter-status-bar">
          <span class="filter-count-text">
            Menampilkan <strong id="visibleCount">{projects.length + initialBulkPosts.length}</strong> dari {totalProjectsCount}+ dokumentasi proyek
          </span>
          <button type="button" class="reset-filter-btn" id="resetFilterBtn" style="display: none;">
            <svg class="reset-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
            Reset Semua Filter
          </button>
        </div>
      </div>

      <!-- Featured Projects Section -->
      <div class="portfolio-section-block" id="featuredSectionBlock">
        <div class="portfolio-section-header">
          <div>
            <span class="badge-sub" style="background-color: rgba(15,43,72,0.08); color: var(--primary);">Dokumentasi Utama</span>
            <h2 class="portfolio-section-title">Proyek Pilihan Unggulan</h2>
            <p class="portfolio-section-desc">8 Proyek flagship terkurasi dengan dokumentasi galeri multi-sudut, denah pemasangan, dan spesifikasi terinci.</p>
          </div>
        </div>

        <div class="portfolio-grid" id="featuredProjectsGrid">
          {projects.map((proj) => (
            <ProjectCard project={proj} />
          ))}
        </div>
      </div>

      <!-- Clustered & Standalone Archive Projects Section -->
      <div class="portfolio-section-block" id="archiveSectionBlock">
        <div class="portfolio-section-header">
          <div>
            <span class="badge-sub" style="background-color: rgba(234,88,12,0.1); color: var(--accent);">Dokumentasi Riil &amp; Klaster Terpadu</span>
            <h2 class="portfolio-section-title">Dokumentasi Lapangan &amp; Klaster Terpadu</h2>
            <p class="portfolio-section-desc">Dokumentasi riil tim Griya Alfath di wilayah Solo Raya.</p>
          </div>
        </div>

        <div class="portfolio-grid" id="bulkProjectsGrid">
          {initialBulkPosts.map((post) => (
            <ProjectCard project={post as any} />
          ))}
        </div>

        <!-- Progressive Load More Button -->
        <div class="load-more-container" id="loadMoreContainer">
          <button type="button" class="btn-load-more" id="loadMoreBtn">
            <span id="loadMoreText">Muat 8 Dokumentasi Lainnya</span>
            <span id="loadMoreBadge" class="load-more-badge">
              (Tersedia {clusteredPortfolioPages.length - initialBulkPosts.length} konten)
            </span>
          </button>
        </div>
      </div>

      <!-- Empty State Fallback -->
      <div class="empty-filter-state" id="emptyFilterState" style="display: none;">
        <div class="empty-icon-wrap">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        </div>
        <h3>Tidak Ditemukan Proyek pada Kombinasi Filter Ini</h3>
        <p>Belum ada dokumentasi publik untuk kombinasi layanan dan jenis bangunan yang dipilih. Silakan atur ulang filter atau pilih "Semua".</p>
        <button type="button" class="btn btn-primary btn-sm" id="emptyResetBtn">
          Tampilkan Semua Proyek
        </button>
      </div>

    </div>
  </section>

  <!-- Local GEO Territory Overview -->
  <section class="section-py bg-alt">
    <div class="container">
      <div class="geo-territory-card">
        <div class="geo-header">
          <span class="badge-sub" style="background-color: rgba(15,43,72,0.08); color: var(--primary);">Jangkauan Layanan Lapangan</span>
          <h3 class="geo-title">Wilayah Pengerjaan &amp; Pengiriman Gratis Solo Raya</h3>
          <p class="geo-desc">
            Tim aplikator dan armada logistik Griya Alfath melayani konsultasi langsung, survei ukuran denah gratis, dan pengiriman material tepat waktu ke seluruh penjuru eks-Karesidenan Surakarta.
          </p>
        </div>
        <div class="geo-pills-grid">
          <div class="geo-pill">
            <strong>Kota Surakarta</strong>
            <span>Banjarsari, Jebres, Laweyan, Pasar Kliwon, Serengan</span>
          </div>
          <div class="geo-pill">
            <strong>Kabupaten Sukoharjo</strong>
            <span>Kartasura, Grogol, Baki, Mojolaban, Tawangsari, Bendosari</span>
          </div>
          <div class="geo-pill">
            <strong>Kabupaten Klaten</strong>
            <span>Delanggu, Ceper, Wonosari, Klaten Utara, Klaten Selatan, Pedan</span>
          </div>
          <div class="geo-pill">
            <strong>Kabupaten Boyolali</strong>
            <span>Boyolali Kota, Mojosongo, Banyudono, Sawit, Ngemplak, Sambi</span>
          </div>
          <div class="geo-pill">
            <strong>Kabupaten Karanganyar</strong>
            <span>Colomadu, Jaten, Karanganyar Kota, Tasikmadu, Kebakkramat</span>
          </div>
          <div class="geo-pill">
            <strong>Kab. Wonogiri &amp; Sragen</strong>
            <span>Wonogiri Kota, Selogiri, Bulusulur, Sragen Kota, Masaran</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-Resource Navigation & CTA Banner -->
  <section class="section-py bg-white">
    <div class="container">
      <div class="portfolio-cta-card">
        <div class="cta-inner-grid">
          <div class="cta-text-col">
            <span class="badge-sub" style="background-color: rgba(255,255,255,0.15); color: #fed7aa; margin-bottom: 0.75rem;">Konsultasi &amp; Estimasi</span>
            <h3 class="cta-title">Ingin Menerapkan Konsep Serupa pada Hunian Anda?</h3>
            <p class="cta-desc">
              Tim aplikator Griya Alfath siap membantu survei lokasi dan menghitungkan estimasi kebutuhan bahan serta biaya pemasangan secara transparan di seluruh Solo Raya.
            </p>
            <div class="cta-links-row">
              <a
                href="https://wa.me/6282157249454?text=Halo%20Griya%20Alfath,%20saya%20tertarik%20dengan%20portofolio%20pemasangan%20di%20website%20dan%20ingin%20konsultasi%20proyek"
                class="btn btn-accent btn-lg"
                target="_blank"
                rel="noopener"
              >
                <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.33C9.33 7.33 9 7.41 8.74 7.69C8.47 7.96 7.74 8.64 7.74 10.05C7.74 11.45 8.77 12.81 8.91 13C9.05 13.2 10.92 16.08 13.8 17.32C14.49 17.61 15.02 17.79 15.44 17.93C16.13 18.15 16.76 18.12 17.26 18.04C17.81 17.96 18.96 17.35 19.2 16.67C19.44 16 19.44 15.41 19.37 15.3C19.3 15.19 19.11 15.12 18.82 14.98C18.53 14.84 17.11 14.14 16.85 14.05C16.59 13.95 16.4 13.91 16.21 14.2C16.02 14.5 15.48 15.12 15.31 15.3C15.15 15.5 14.99 15.52 14.7 15.37C14.41 15.23 13.49 14.93 12.4 13.96C11.55 13.2 10.98 12.27 10.82 11.98C10.65 11.7 10.8 11.54 10.95 11.4C11.08 11.27 11.24 11.06 11.39 10.89C11.53 10.72 11.58 10.6 11.68 10.4C11.77 10.2 11.72 10.03 11.65 9.89C11.58 9.74 11 8.33 10.76 7.76C10.53 7.21 10.3 7.28 10.13 7.27L9.53 7.33Z"/></svg>
                Konsultasi WhatsApp Sekarang
              </a>
            </div>
          </div>
          <div class="cta-shortcuts-col">
            <h4 class="shortcuts-title">Tautan Cepat Layanan Terkait</h4>
            <div class="shortcuts-list">
              <a href="/katalog/" class="shortcut-item">
                <div class="sc-icon">
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
                </div>
                <div class="sc-text">
                  <strong>Katalog Produk &amp; Merek</strong>
                  <span>Lihat spesifikasi plafon Lamiwood, Alfafon, dan Jayaboard</span>
                </div>
                <svg class="sc-arrow" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href="/kalkulator/" class="shortcut-item">
                <div class="sc-icon">
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-6 2h5v3h-5V5zm-2 0v3H6V5h5zm-5 5h5v3H6v-3zm7 0h5v3h-5v-3zm-7 5h5v4H6v-4zm7 4v-4h5v4h-5z"/></svg>
                </div>
                <div class="sc-text">
                  <strong>Estimasi Biaya Ruangan</strong>
                  <span>Simulasi hitung kebutuhan lembar plafon dan rangka proyek Anda</span>
                </div>
                <svg class="sc-arrow" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href="/kontak/" class="shortcut-item">
                <div class="sc-icon">
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                </div>
                <div class="sc-text">
                  <strong>Lokasi Toko &amp; Gudang</strong>
                  <span>Alamat showroom Delanggu, Kartasura, Bulusulur &amp; Tlobong</span>
                </div>
                <svg class="sc-arrow" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  interface SearchIndexItem {
    s: string;
    t: string;
    c: string;
    cl: string;
    b: string;
    bl: string;
    l: string;
    i: string;
    d: string;
    type?: 'standalone' | 'cluster';
  }

  document.addEventListener('DOMContentLoaded', () => {
    const serviceSelect = document.getElementById('serviceFilterSelect') as HTMLSelectElement | null;
    const buildingSelect = document.getElementById('buildingFilterSelect') as HTMLSelectElement | null;
    const featuredBlock = document.getElementById('featuredSectionBlock');
    const archiveBlock = document.getElementById('archiveSectionBlock');
    const featuredCards = document.querySelectorAll<HTMLElement>('#featuredProjectsGrid .portfolio-card');
    const bulkGrid = document.getElementById('bulkProjectsGrid');
    const visibleCountEl = document.getElementById('visibleCount');
    const emptyStateEl = document.getElementById('emptyFilterState');
    const resetBtn = document.getElementById('resetFilterBtn');
    const emptyResetBtn = document.getElementById('emptyResetBtn');
    const loadMoreBtn = document.getElementById('loadMoreBtn') as HTMLButtonElement | null;
    const loadMoreContainer = document.getElementById('loadMoreContainer');
    const loadMoreText = document.getElementById('loadMoreText');
    const loadMoreBadge = document.getElementById('loadMoreBadge');

    let allArchiveData: SearchIndexItem[] | null = null;
    let filteredArchiveData: SearchIndexItem[] = [];
    let currentRenderedCount = 4;
    const BATCH_SIZE = 8;

    async function loadArchiveIndex(): Promise<SearchIndexItem[]> {
      if (allArchiveData) return allArchiveData;
      try {
        const response = await fetch('/data/portfolio-index.json');
        if (!response.ok) throw new Error('Network error loading index');
        allArchiveData = await response.json();
        return allArchiveData || [];
      } catch (err) {
        console.error('Failed to load portfolio index:', err);
        return [];
      }
    }

    function createCardElement(item: SearchIndexItem): HTMLElement {
      const card = document.createElement('div');
      card.className = 'portfolio-card';
      card.setAttribute('data-service', item.c);
      card.setAttribute('data-building', item.b);
      card.setAttribute('data-category', item.c);

      const detailUrl = `/portofolio/${item.s}/`;
      const buildingTag = item.bl ? `<span class="portfolio-building-tag">${item.bl}</span>` : '';
      const typeBadge = item.type === 'cluster' ? `<span class="portfolio-type-badge">Klaster Terpadu</span>` : '';
      const locationRow = item.l ? `
        <div class="portfolio-location-row">
          <svg class="loc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <span class="portfolio-location">${item.l}</span>
        </div>` : '';

      card.innerHTML = `
        <div class="portfolio-img-container">
          <img src="${item.i}" alt="${item.t}" loading="lazy" class="portfolio-img" />
          <span class="portfolio-tag">${item.cl}</span>
          ${buildingTag}
          ${typeBadge}
          <a href="${item.i}" class="portfolio-zoom-btn" data-lightbox data-caption="${item.t} — ${item.cl} (${item.l})" aria-label="Pratinjau foto ${item.t}" title="Perbesar foto">
            <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </a>
          <a href="${detailUrl}" class="portfolio-img-overlay-link" aria-label="Buka detail dokumentasi ${item.t}"></a>
        </div>
        <div class="portfolio-info">
          <div class="portfolio-header-line">
            <h3 class="portfolio-name">
              <a href="${detailUrl}" class="portfolio-title-link">${item.t}</a>
            </h3>
          </div>
          ${locationRow}
          <p class="portfolio-desc">${item.d}</p>
          <div class="portfolio-footer-row">
            <a href="${detailUrl}" class="portfolio-detail-btn">
              <span>Lihat Dokumentasi Lengkap</span>
              <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      `;
      return card;
    }

    async function applyFilter() {
      const activeService = serviceSelect ? serviceSelect.value : 'all';
      const activeBuilding = buildingSelect ? buildingSelect.value : 'all';
      const isFiltered = activeService !== 'all' || activeBuilding !== 'all';

      // 1. Filter Featured Cards
      let visibleFeaturedCount = 0;
      featuredCards.forEach((card) => {
        const cardService = card.getAttribute('data-service') || '';
        const cardBuilding = card.getAttribute('data-building') || '';
        const matchService = activeService === 'all' || cardService === activeService;
        const matchBuilding = activeBuilding === 'all' || cardBuilding === activeBuilding;

        if (matchService && matchBuilding) {
          card.style.display = '';
          visibleFeaturedCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (featuredBlock) {
        featuredBlock.style.display = visibleFeaturedCount > 0 ? '' : 'none';
      }

      // 2. Filter Bulk Archive
      const allData = await loadArchiveIndex();
      filteredArchiveData = allData.filter((item) => {
        const matchService = activeService === 'all' || item.c === activeService;
        const matchBuilding = activeBuilding === 'all' || item.b === activeBuilding;
        return matchService && matchBuilding;
      });

      currentRenderedCount = Math.min(BATCH_SIZE, filteredArchiveData.length);

      // Re-populate bulkGrid with filtered subset
      if (bulkGrid) {
        bulkGrid.innerHTML = '';
        const initialBatch = filteredArchiveData.slice(0, currentRenderedCount);
        initialBatch.forEach((item) => {
          bulkGrid.appendChild(createCardElement(item));
        });
      }

      const totalVisible = visibleFeaturedCount + currentRenderedCount;
      const totalAvailable = visibleFeaturedCount + filteredArchiveData.length;

      if (visibleCountEl) {
        visibleCountEl.textContent = `${totalVisible} dari ${totalAvailable}`;
      }

      if (archiveBlock) {
        archiveBlock.style.display = filteredArchiveData.length > 0 ? '' : 'none';
      }

      if (emptyStateEl) {
        emptyStateEl.style.display = totalAvailable === 0 ? 'block' : 'none';
      }

      if (resetBtn) {
        resetBtn.style.display = isFiltered ? 'inline-flex' : 'none';
      }

      updateLoadMoreButton();
    }

    function updateLoadMoreButton() {
      if (!loadMoreContainer || !loadMoreBtn) return;
      const remaining = filteredArchiveData.length - currentRenderedCount;

      if (remaining > 0) {
        loadMoreContainer.style.display = 'flex';
        const nextBatch = Math.min(BATCH_SIZE, remaining);
        if (loadMoreText) loadMoreText.textContent = `Muat ${nextBatch} Dokumentasi Lainnya`;
        if (loadMoreBadge) loadMoreBadge.textContent = `(Tersisa ${remaining} konten)`;
        loadMoreBtn.disabled = false;
      } else {
        loadMoreContainer.style.display = 'none';
      }
    }

    async function handleLoadMore() {
      if (!bulkGrid || !loadMoreBtn) return;
      loadMoreBtn.disabled = true;
      if (loadMoreText) loadMoreText.textContent = 'Memuat Dokumentasi...';

      if (!allArchiveData) {
        await loadArchiveIndex();
      }

      const nextBatch = filteredArchiveData.slice(currentRenderedCount, currentRenderedCount + BATCH_SIZE);
      nextBatch.forEach((item) => {
        bulkGrid.appendChild(createCardElement(item));
      });

      currentRenderedCount += nextBatch.length;

      // Update visible count in status bar
      let visibleFeaturedCount = 0;
      featuredCards.forEach(c => { if (c.style.display !== 'none') visibleFeaturedCount++; });
      if (visibleCountEl) {
        const totalVisible = visibleFeaturedCount + currentRenderedCount;
        const totalAvailable = visibleFeaturedCount + filteredArchiveData.length;
        visibleCountEl.textContent = `${totalVisible} dari ${totalAvailable}`;
      }

      updateLoadMoreButton();
    }

    async function resetFilters() {
      if (serviceSelect) serviceSelect.value = 'all';
      if (buildingSelect) buildingSelect.value = 'all';
      await applyFilter();
    }

    // Initialize filteredArchiveData with full dataset in background
    loadArchiveIndex().then((data) => {
      filteredArchiveData = data;
      updateLoadMoreButton();
    });

    if (serviceSelect) serviceSelect.addEventListener('change', applyFilter);
    if (buildingSelect) buildingSelect.addEventListener('change', applyFilter);
    if (resetBtn) resetBtn.addEventListener('click', resetFilters);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetFilters);
    if (loadMoreBtn) loadMoreBtn.addEventListener('click', handleLoadMore);
  });
</script>

