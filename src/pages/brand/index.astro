---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { brands } from '../../data/brands';

const breadcrumbItems = [
  { label: 'Brand Pilihan', href: '/brand/' }
];

const pvcBrands = brands.filter(b => b.categoryType === 'pvc');
const gypsumBrands = brands.filter(b => b.categoryType === 'gypsum');
const bajaBrands = brands.filter(b => b.categoryType === 'baja-ringan');
const panelBrands = brands.filter(b => b.categoryType === 'panel');
const aksesoriBrands = brands.filter(b => b.categoryType === 'aksesori');
---

<BaseLayout
  title="Brand Resmi Material Plafon & Konstruksi — Plafon PVC Solo by Griya Alfath"
  description="Daftar brand resmi mitra Plafon PVC Solo by Griya Alfath: LAMIWOOD, ALFAFON, SAKURA, GOLDEN, INDOKING, BATIK, JAYABOARD, KENCANA, MOTTO, JANUR, dan HONOR DECORATION."
  currentPath="/brand/"
>
  <!-- Page Banner -->
  <section class="page-banner">
    <video autoplay muted loop playsinline poster="/images/hero/hero-plafon-main.webp" class="banner-video-bg" aria-hidden="true">
      <source src="/videos/banner-bg.mp4" type="video/mp4" />
    </video>
    <div class="banner-overlay" aria-hidden="true"></div>

    <div class="container">
      <span class="badge-sub" style="background-color: rgba(255,255,255,0.15); color: #fed7aa; margin-bottom: 0.75rem;">Brand Resmi Mitra</span>
      <h1 class="page-banner-title">Brand Pilihan Berkualitas Terpercaya</h1>
      <p class="page-banner-desc">Kami bermitra dengan produsen material ternama yang telah teruji mutunya dalam industri plafon, gypsum, baja ringan, wall panel, dan dekorasi interior di Solo Raya.</p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <Breadcrumb items={breadcrumbItems} />

  <!-- PVC Brands -->
  <section class="section-py bg-white">
    <div class="container">
      <div class="category-block-header">
        <span class="badge-sub">Kategori 1</span>
        <h2 class="section-title">Brand Plafon PVC &amp; UPVC Unggulan</h2>
        <p class="section-desc">Plafon PVC dan UPVC dengan pilihan motif serat kayu alami, marmer glossy, ornamen etnik lokal, dan list interlock rapat anti air 100%.</p>
      </div>

      <div class="brands-detail-grid">
        {pvcBrands.map(b => (
          <div class="brand-detail-card">
            <div class="brand-detail-img">
              {b.image ? (
                <img src={b.image} alt={`Brand Plafon PVC ${b.name}`} loading="lazy" />
              ) : (
                <div class="brand-initials">{b.initials || b.name.substring(0, 2)}</div>
              )}
            </div>
            <div class="brand-detail-body">
              <div class="brand-meta-header">
                <span class="brand-cat-tag">{b.category}</span>
                {b.isBestSeller && <span class="brand-best-tag">★ Best Seller</span>}
              </div>
              <h3 class="brand-detail-name">{b.name}</h3>
              <p class="brand-detail-desc">{b.description}</p>
              <div class="brand-actions">
                <a href={b.catalogUrl} class="btn btn-sm btn-outline">
                  <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  Lihat Katalog
                </a>
                <a
                  href={`https://wa.me/6282157249454?text=${encodeURIComponent(b.whatsappMessage)}`}
                  class="btn btn-sm btn-whatsapp-green"
                  target="_blank"
                  rel="noopener"
                >
                  <svg class="icon-svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.33C9.33 7.33 9 7.41 8.74 7.69C8.47 7.96 7.74 8.64 7.74 10.05C7.74 11.45 8.77 12.81 8.91 13C9.05 13.2 10.92 16.08 13.8 17.32C14.49 17.61 15.02 17.79 15.44 17.93C16.13 18.15 16.76 18.12 17.26 18.04C17.81 17.96 18.96 17.35 19.2 16.67C19.44 16 19.44 15.41 19.37 15.3C19.3 15.19 19.11 15.12 18.82 14.98C18.53 14.84 17.11 14.14 16.85 14.05C16.59 13.95 16.4 13.91 16.21 14.2C16.02 14.5 15.48 15.12 15.31 15.3C15.15 15.5 14.99 15.52 14.7 15.37C14.41 15.23 13.49 14.93 12.4 13.96C11.55 13.2 10.98 12.27 10.82 11.98C10.65 11.7 10.8 11.54 10.95 11.4C11.08 11.27 11.24 11.06 11.39 10.89C11.53 10.72 11.58 10.6 11.68 10.4C11.77 10.2 11.72 10.03 11.65 9.89C11.58 9.74 11 8.33 10.76 7.76C10.53 7.21 10.3 7.28 10.13 7.27L9.53 7.33Z"/>
