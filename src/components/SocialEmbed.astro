---
import type { SocialEmbed } from '../data/portfolio-posts';

interface Props {
  embed: SocialEmbed;
  title: string;
  sourceUrl: string;
}

const { embed, title, sourceUrl } = Astro.props;

const platformLabels = {
  instagram: 'Instagram',
  tiktok: 'TikTok',
  facebook: 'Facebook',
  youtube: 'YouTube',
  unknown: 'Media Sosial'
};

const platformName = platformLabels[embed.platform] || 'Media Sosial';
---

<div class="social-embed-card" data-platform={embed.platform}>
  <div class="embed-header">
    <div class="embed-header-left">
      <span class={`platform-badge badge-${embed.platform}`}>
        {platformName}
      </span>
      <span class="embed-verified-tag">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
        Dokumentasi Lapangan Resmi
      </span>
    </div>
    <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="embed-source-link">
      Buka di {platformName} &nearr;
    </a>
  </div>

  <div class="embed-media-container">
    {embed.platform === 'instagram' && (
      <div class="instagram-wrapper">
        <blockquote
          class="instagram-media"
          data-instgrm-permalink={embed.embedUrl}
          data-instgrm-version="14"
          style="background:#FFF; border:0; border-radius:12px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px auto; max-width:540px; min-width:326px; padding:0; width:calc(100% - 2px);"
        >
          <div style="padding:16px;">
            <a
              href={embed.embedUrl}
              style="background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;"
              target="_blank"
              rel="noopener noreferrer"
            >
              Lihat postingan dokumentasi ini di Instagram resmi @plafonpvcsolo
            </a>
          </div>
        </blockquote>
        <script async defer src="//www.instagram.com/embed.js"></script>
      </div>
    )}

    {embed.platform === 'tiktok' && (
      <div class="tiktok-wrapper">
        <blockquote
          class="tiktok-embed"
          cite={embed.embedUrl}
          data-video-id={embed.id}
          style="max-width:605px; min-width:325px; margin: 0 auto;"
        >
          <section>
            <a
              target="_blank"
              title={embed.username || '@plafonpvcsolo'}
              href={`https://www.tiktok.com/${embed.username || '@plafonpvcsolo'}?refer=embed`}
            >
              {embed.username || '@plafonpvcsolo'}
            </a>
          </section>
        </blockquote>
        <script async src="https://www.tiktok.com/embed.js"></script>
      </div>
    )}

    {embed.platform === 'facebook' && (
      <div class="facebook-wrapper">
        <iframe
          src={embed.embedUrl}
          width="100%"
          height="500"
          style="border:none;overflow:hidden;border-radius:12px;"
          scrolling="no"
          frameborder="0"
          allowfullscreen="true"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          title={`Dokumentasi Facebook — ${title}`}
          loading="lazy"
        ></iframe>
      </div>
    )}

    {embed.platform === 'youtube' && (
      <div class={embed.isShorts ? 'youtube-shorts-wrapper' : 'youtube-standard-wrapper'}>
        <iframe
          src={embed.embedUrl}
          title={`Dokumentasi YouTube — ${title}`}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    )}
  </div>

  <div class="embed-footer">
    <p class="embed-caption-note">
      Dokumentasi ini disematkan langsung dari kanal resmi Griya Alfath sebagai bukti otentik transparansi material dan kerapian hasil pekerjaan di lapangan.
    </p>
    <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">
      Kunjungi Postingan Sumber ({platformName})
    </a>
  </div>
</div>

<style>
  .social-embed-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .embed-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background-color: #f8fafc;
    border-bottom: 1px solid var(--border-color);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .embed-header-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .platform-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    color: #ffffff;
  }

  .badge-instagram {
    background: linear-gradient(135deg, #833ab4 0%, #fd1d1d 50%, #fcb045 100%);
  }

  .badge-tiktok {
    background: #000000;
  }

  .badge-facebook {
    background: #1877f2;
  }

  .badge-youtube {
    background: #ff0000;
  }

  .embed-verified-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #166534;
  }

  .embed-verified-tag svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .embed-source-link {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    transition: var(--transition);
  }

  .embed-source-link:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .embed-media-container {
    padding: 1.5rem;
    background-color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 380px;
  }

  .instagram-wrapper,
  .tiktok-wrapper {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
  }

  .facebook-wrapper {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .youtube-standard-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    height: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .youtube-standard-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .youtube-shorts-wrapper {
    position: relative;
    width: 100%;
    max-width: 340px;
    padding-bottom: 177.77%; /* 9:16 Aspect Ratio */
    height: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 0 auto;
  }

  .youtube-shorts-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .embed-footer {
    padding: 1rem 1.25rem;
    background-color: #f8fafc;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .embed-caption-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 650px;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .embed-media-container {
      padding: 1rem 0.5rem;
      min-height: 300px;
    }

    .embed-header,
    .embed-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

